# Copy this to .env and fill in values — never commit .env

# MySQL (Railway provides these automatically when you add a MySQL plugin)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=railway

# Shared secret for HMAC price signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRICE_SIGNING_SECRET=change_me_to_a_random_64_char_hex_string

# Admin password for the CSV import page
IMPORT_ADMIN_PASSWORD=change_me

# Port (Railway sets this automatically)
PORT=3000
